# Environment Configuration Example
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=police-roster-secret-key-super-secure-change-in-prod

# Database Configuration (MySQL format or SQLite fallback)
# MySQL Example: mysql+pymysql://root:password@localhost:3306/police_roster_db
DATABASE_URL=sqlite:///police_roster.db

# Roster & Risk Engine Parameters
MIN_REST_HOURS=11
MAX_WEEKLY_HOURS=48
MAX_CONSECUTIVE_DAYS=6
